# Opportunity Radar local environment
# Copy to .env and keep the real file private.

# CP5 PostgreSQL / Supabase connection string.
# Copy it from the Supabase "Connect" dialog.
# Include sslmode=require when using Supabase.
DATABASE_URL=

# CP5-A keeps the production collector on SQLite while PostgreSQL parity
# is validated. Cutover happens only after the remote backend is proven.
